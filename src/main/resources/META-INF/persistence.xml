<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="gestion-academique-pu" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Entités -->
        <class>com.syllahib.hibernategestionacademique.model.Filiere</class>
        <class>com.syllahib.hibernategestionacademique.model.Eleve</class>
        <class>com.syllahib.hibernategestionacademique.model.DossierAdministratif</class>
        <class>com.syllahib.hibernategestionacademique.model.Cours</class>

        <properties>
            <!-- Configuration de la base de données (Jakarta = jakarta.persistence.*) -->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3306/hibgesacad?createDatabaseIfNotExist=true&amp;useSSL=false&amp;serverTimezone=UTC"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value="admin1234"/>

            <!-- Afficher les requêtes SQL -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.use_sql_comments" value="true"/>

            <!-- Créer/Mettre à jour le schéma automatiquement -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>

            <!-- Pool de connexions -->
            <property name="hibernate.connection.pool_size" value="10"/>

            <!-- Cache de second niveau -->
            <property name="hibernate.cache.use_second_level_cache" value="false"/>

            <!-- Encodage -->
            <property name="hibernate.connection.CharSet" value="utf8"/>
            <property name="hibernate.connection.characterEncoding" value="utf8"/>
            <property name="hibernate.connection.useUnicode" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
